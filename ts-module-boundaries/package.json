{
  "name": "ts-module-boundaries",
  "version": "1.0.0",
  "description": "Comprehensive, digestible demonstration of TypeScript module boundaries best practices",
  "type": "module",
  "scripts": {
    "demo": "bun run src/demo.ts",
    "demo:all": "bun run src/demo.ts --all",
    "test": "bun test",
    "lint:depgraph": "depcruise --config .dependency-cruiser.cjs .",
