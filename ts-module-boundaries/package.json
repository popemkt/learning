    "dependency-cruiser",
    "package-exports",
    "eslint",
    "oxlint"
  ],
  "devDependencies": {
    "@types/node": "^22.13.0",
    "dependency-cruiser": "^16.9.0",
    "oxlint": "^0.15.0",
    "typescript": "^5.7.3"
  }
}
